// EMBL-EBI Codon (SLURM + Singularity): the Nextflow configuration the objectives ran with.
//   export NF_CONFIG=$REPO/env/nextflow/codon.config CONTAINER_ENGINE=singularity RUNNER=slurm
// Covers SanntiS's fan-out labels (cpu_small, antismash, train) and InterProScan 6's own processes. The size of
// the InterProScan 6 runs (cores per task, concurrent chunk runs, queue size) is set in common/env.sh
// (SANNTIS_IPS6_*), not here, so it does not limit the other fan-out steps.

executor {
    name              = 'slurm'
    queueSize         = 200
    submitRateLimit   = '20/1min'
    pollInterval      = '30 sec'
    queueStatInterval = '2 min'
    // jobs of <= 4 h are re-routed from `standard` to `short`; the per-queue status query would lose them
    queueGlobalStatus = true
    exitReadTimeout   = '30 min'
}

singularity {
    enabled     = true
    autoMounts  = true
    pullTimeout = '3 hours'
}

process {
    executor = 'slurm'
    queue    = 'standard'

    withName: 'DOWNLOAD_INTERPRO|DOWNLOAD_DATABASE' {
        queue = 'datamover'
        time  = '12h'
    }
    withLabel: cpu_small {
        queue  = 'short'
        cpus   = 2
        memory = '8 GB'
        time   = '4h'
    }
    withLabel: antismash {
        cpus   = 8
        memory = '32 GB'
        time   = '24h'
    }
    // detectors train on CPU: torch threads = the allocation, passive OpenMP waits on shared nodes
    withLabel: train {
        cpus         = 16
        memory       = '32 GB'
        time         = '48h'
        beforeScript = 'export SANNTIS_THREADS=$SLURM_CPUS_PER_TASK OMP_WAIT_POLICY=PASSIVE'
    }
    withLabel: gpu {
        queue          = 'gpu'
        cpus           = 8
        memory         = '32 GB'
        time           = '48h'
        clusterOptions = '--gres=gpu:1'
    }
}
